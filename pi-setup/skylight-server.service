# systemd unit for the Skylight server (data + WebSocket + serves the built web app).
# Installed to /etc/systemd/system/ by install-on-pi.sh.
[Unit]
Description=Skylight server
After=network-online.target dump1090-fa.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
Environment=DATA_SOURCE=__DATA_SOURCE__
Environment=AIRCRAFT_JSON_URL=http://localhost:8080/data/aircraft.json
# Poll the decoder at 2 Hz (it rewrites aircraft.json every 0.5 s): the camera
# tracker dead-reckons from these fixes, and every second of latency is degrees.
Environment=POLL_MS=500
ExecStart=__PNPM__ -F server start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
